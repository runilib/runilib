{
  "$schema": "https://turbo.build/schema.json",

  "globalDependencies": [
    "package.json",
    "yarn.lock",
    "tsconfig.base.json",
    "biome.jsonc",
    "vitest.workspace.ts",
    "vitest.shared.ts"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "build/**",
        "lib/**"
      ]
    },

    // Dev = tâche longue, pas de cache
    "dev": {
      "cache": false,
      "persistent": true
    },

    // Lint et check: pas de cache de fichiers générés
    "lint": {
      "cache": false,
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "check": {
      "outputs": []
    },

    "check:fix": {
      "outputs": []
    },

    // Typecheck
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },

    // Tests
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },

    "clean": {
      "cache": false
    }
  }
}