{
  "$schema": "https://json.schemastore.org/tsconfig",
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useDefineForClassFields": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "isolatedModules": false,
    "jsx": "react-native",
    "target": "esnext",
    "module": "esnext",
    "types": ["react-native", "jest", "node", "react"],
    "lib": [
      "es2019",
      "es2020.bigint",
      "es2020.date",
      "es2020.number",
      "es2020.promise",
      "es2020.string",
      "es2020.symbol.wellknown",
      "es2021.promise",
      "es2021.string",
      "es2021.weakref",
      "es2022.array",
      "es2022.object",
      "es2022.string"
    ],
    "pretty": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "composite": true,
    "noEmit": false,
    "paths": {}
  }
}
