{
  "name": "@runilib/website",
  "version": "0.0.1",
  "private": true,
  "description": "React UniKit documentation website",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome ci src",
    "lint:fix": "biome check --write src",
    "tsc:check": "tsc --noEmit --project ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@runilib/tooltip": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.9",
    "@runilib/biome-config": "workspace:*",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0"
  }
}
