{
  "name": "nimbo-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "biome lint src .",
    "lint:fix": "biome lint --write src .",
    "check": "biome check src .",
    "check:fix": "biome check --write src .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf .next coverage"
  },
  "dependencies": {
    "@runilib/nimbo": "workspace:*",
    "next": "^15.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.0"
  }
}
