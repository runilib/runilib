{
  "expo": {
    "name": "Taskflow",
    "slug": "runilib-example-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": { "resizeMode": "contain", "backgroundColor": "#f9f5ee" },
    "ios":     { "supportsTablet": false, "bundleIdentifier": "dev.runilib.example" },
    "android": { "adaptiveIcon": { "backgroundColor": "#f9f5ee" }, "package": "dev.runilib.example" },
    "scheme": "taskflow",
    "plugins": ["expo-router"],
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
