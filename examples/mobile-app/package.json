{
  "name": "@examples/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "dev": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "echo \"No production build script yet for mobile example\"",
    "lint": "biome lint app src .",
    "lint:fix": "biome lint --write app src .",
    "check": "biome check app src .",
    "check:fix": "biome check --write app src .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf coverage .expo"
  },
  "dependencies": {
    "@runilib/react-walkit": "workspace:*",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.13",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@biomejs/biome": "^2.4.8",
    "@types/react": "~19.1.10",
    "@vitest/coverage-v8": "^4.1.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.1"
  }
}
